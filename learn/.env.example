# =============================================================================
# agentic-ai-bootcamp の環境変数テンプレート / Environment template
# 使い方 / Usage:  cp .env.example .env  then edit values below.
# =============================================================================

# どのプロバイダを使うか / Which provider to use: anthropic | ollama
# - anthropic: 最新の Claude を使う（API キーが必要・有償）。学習品質が高い。
#              Use the latest Claude (needs an API key, paid). Highest quality.
# - ollama:    ローカルで無償実行（要 `ollama serve`）。API コスト不要。
#              Run locally for free (needs `ollama serve`). No API cost.
LLM_PROVIDER=anthropic

# -----------------------------------------------------------------------------
# Anthropic (LLM_PROVIDER=anthropic のとき / when LLM_PROVIDER=anthropic)
# -----------------------------------------------------------------------------
# https://console.anthropic.com/ で取得 / Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# モデル ID / Model ID. 最新世代から選ぶ / pick from the latest generation:
#   claude-sonnet-4-6  … バランス型・既定 / balanced, default
#   claude-haiku-4-5   … 低コスト・高速 / cheaper & faster (学習におすすめ / great for learning)
#   claude-opus-4-8    … 最難タスク向け / for the hardest tasks
ANTHROPIC_MODEL=claude-sonnet-4-6

# -----------------------------------------------------------------------------
# Ollama (LLM_PROVIDER=ollama のとき / when LLM_PROVIDER=ollama)
# -----------------------------------------------------------------------------
# OpenAI 互換エンドポイント。末尾の /v1 は必須 / OpenAI-compatible endpoint; the trailing /v1 is required.
OLLAMA_BASE_URL=http://localhost:11434/v1
# `ollama pull <model>` 済みのモデル名 / a model you have pulled via `ollama pull <model>`
OLLAMA_MODEL=llama3.2
# 通常は不要 / usually not needed
# OLLAMA_API_KEY=

# -----------------------------------------------------------------------------
# Observability (lesson 05, 任意 / optional)
# -----------------------------------------------------------------------------
# 1 にすると Logfire 計装を有効化 / set to 1 to enable Logfire instrumentation
# LOGFIRE_ENABLED=0
# LOGFIRE_TOKEN=
